        <mxCell id="n_voyagesvc" value="VoyageService [LIVE]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d3f9d8;strokeColor=#2b8a3e;" vertex="1" parent="1">
          <mxGeometry x="430" y="390" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n_stubsvc" value="Expense / Image / Itinerary /&#10;Location / TravelGroup / User&#10;Services [SCAFFOLDED]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3bf;strokeColor=#e8a93b;" vertex="1" parent="1">
          <mxGeometry x="590" y="385" width="130" height="80" as="geometry" />
        </mxCell>

        <!-- ================= REPOSITORY NODES ================= -->
        <mxCell id="n_userrepo" value="UserRepository" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7e0ff;strokeColor=#6741d9;" vertex="1" parent="1">
