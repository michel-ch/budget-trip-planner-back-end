<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device">
  <diagram id="budget-trip-planner-architecture" name="System Architecture">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ================= ZONE GROUP BOXES ================= -->
        <mxCell id="zone_public" value="PUBLIC ZONE - untrusted (outside trust boundary)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f3f5;strokeColor=#495057;dashed=1;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="940" y="40" width="400" height="260" as="geometry" />
        </mxCell>
        <mxCell id="zone_app" value="APPLICATION ZONE - Spring Boot monolith :8080, base path /api" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9db;strokeColor=#e8a93b;dashed=0;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="860" height="820" as="geometry" />
        </mxCell>
        <mxCell id="zone_data" value="DATA ZONE - trusted backend datastore" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5ff;strokeColor=#1971c2;dashed=1;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="300" y="940" width="520" height="150" as="geometry" />
        </mxCell>

        <!-- ================= APP SUB-ZONES ================= -->
        <mxCell id="zone_security" value="Spring Security filter chain - stateless, CSRF disabled, CORS on" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0f0;strokeColor=#c92a2a;dashed=1;verticalAlign=top;fontStyle=2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="320" height="320" as="geometry" />
        </mxCell>
        <mxCell id="zone_controllers" value="Controller layer @RestController (controller + auth.api)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#868e96;dashed=1;verticalAlign=top;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="410" y="150" width="470" height="160" as="geometry" />
        </mxCell>
        <mxCell id="zone_services" value="Service layer @Service @Transactional (com.planner.app.service)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#868e96;dashed=1;verticalAlign=top;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="410" y="350" width="470" height="160" as="geometry" />
        </mxCell>
        <mxCell id="zone_repos" value="Repository layer - Spring Data JPA / Hibernate (com.planner.app.dao)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#868e96;dashed=1;verticalAlign=top;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="120" y="640" width="700" height="180" as="geometry" />
        </mxCell>

        <!-- ================= PUBLIC ZONE NODES ================= -->
        <mxCell id="n_client" value="Angular SPA client&#10;http://localhost:4200&#10;(CORS-allowed origin)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9ecef;strokeColor=#495057;" vertex="1" parent="1">
          <mxGeometry x="980" y="80" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n_authep" value="Public auth endpoints&#10;/api/auth/** (permitAll)&#10;POST /signin, POST /signup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9ecef;strokeColor=#495057;" vertex="1" parent="1">
          <mxGeometry x="1130" y="200" width="190" height="70" as="geometry" />
        </mxCell>

        <!-- ================= SECURITY NODES ================= -->
        <mxCell id="n_jwtfilter" value="JwtAuthenticationFilter&#10;(OncePerRequestFilter)&#10;reads Bearer token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe3e3;strokeColor=#c92a2a;" vertex="1" parent="1">
          <mxGeometry x="90" y="160" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n_jwtutil" value="JwtUtil&#10;HS256 issue + validate token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe3e3;strokeColor=#c92a2a;" vertex="1" parent="1">
          <mxGeometry x="90" y="270" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n_userdetails" value="CustomUserDetailsService +&#10;DaoAuthenticationProvider&#10;BCryptPasswordEncoder" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe3e3;strokeColor=#c92a2a;" vertex="1" parent="1">
          <mxGeometry x="90" y="350" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- ================= CONTROLLER NODES ================= -->
        <mxCell id="n_authctl" value="AuthController [LIVE]&#10;/api/auth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d3f9d8;strokeColor=#2b8a3e;" vertex="1" parent="1">
          <mxGeometry x="730" y="190" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n_voyagectl" value="VoyageController [LIVE]&#10;/api/voyages GET, POST" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d3f9d8;strokeColor=#2b8a3e;" vertex="1" parent="1">
          <mxGeometry x="430" y="190" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n_stubctl" value="Expense / Image / Itinerary /&#10;Location / TravelGroup / User&#10;Controllers [SCAFFOLDED - empty bodies]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3bf;strokeColor=#e8a93b;" vertex="1" parent="1">
          <mxGeometry x="590" y="185" width="130" height="80" as="geometry" />
        </mxCell>

        <!-- ================= SERVICE NODES ================= -->
        <mxCell id="n_authsvc" value="AuthService [LIVE]&#10;login / register" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d3f9d8;strokeColor=#2b8a3e;" vertex="1" parent="1">
