          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ================= EDGES: REPOSITORY -> DATABASE (TRUST BOUNDARY) ================= -->
        <mxCell id="e_userrepo_pg" value="JPA / JDBC SQL [TRUST BOUNDARY]" style="endArrow=block;html=1;strokeColor=#1971c2;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="n_userrepo" target="n_postgres">
