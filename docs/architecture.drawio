        </mxCell>
        <mxCell id="n_voyagerepo" value="VoyageRepository" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7e0ff;strokeColor=#6741d9;" vertex="1" parent="1">
          <mxGeometry x="150" y="710" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n_otherrepo" value="Expense / Image / Itinerary /&#10;Location / TravelGroup Repositories" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3bf;strokeColor=#e8a93b;" vertex="1" parent="1">
          <mxGeometry x="510" y="700" width="250" height="70" as="geometry" />
        </mxCell>

        <!-- ================= DATA ZONE NODE ================= -->
        <mxCell id="n_postgres" value="PostgreSQL  tripbudgetplanner @ localhost:5432&#10;PostgreSQLDialect, HikariCP, ddl-auto=update&#10;entities: User, Voyage, Expense, Itinerary, Image,&#10;Location, TravelGroup (+ friends, group_memberships)&#10;full schema: docs/diagrams/db-schema.mmd" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d0ebff;strokeColor=#1971c2;" vertex="1" parent="1">
          <mxGeometry x="380" y="975" width="360" height="105" as="geometry" />
        </mxCell>

        <!-- ================= EDGES: PUBLIC -> APP (TRUST BOUNDARY) ================= -->
        <mxCell id="e_client_jwt" value="HTTPS / REST + Bearer JWT [TRUST BOUNDARY]" style="endArrow=block;html=1;strokeColor=#c92a2a;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="n_client" target="n_jwtfilter">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_client_authep" value="HTTPS / REST, no token [TRUST BOUNDARY]" style="endArrow=block;html=1;strokeColor=#c92a2a;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="n_client" target="n_authep">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_authep_authctl" value="routes to (permitAll)" style="endArrow=block;html=1;strokeColor=#495057;fontSize=10;" edge="1" parent="1" source="n_authep" target="n_authctl">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ================= EDGES: SECURITY FILTER CHAIN ================= -->
        <mxCell id="e_jwt_util" value="getUsernameFromToken / validateToken" style="endArrow=block;html=1;strokeColor=#c92a2a;fontSize=10;" edge="1" parent="1" source="n_jwtfilter" target="n_jwtutil">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_jwt_userdetails" value="loadUserByUsername" style="endArrow=block;html=1;strokeColor=#c92a2a;fontSize=10;" edge="1" parent="1" source="n_jwtfilter" target="n_userdetails">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_jwt_voyagectl" value="authenticated -&gt; SecurityContext set" style="endArrow=block;html=1;strokeColor=#2b8a3e;fontSize=10;" edge="1" parent="1" source="n_jwtfilter" target="n_voyagectl">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_jwt_stubctl" value="authenticated requests" style="endArrow=block;html=1;strokeColor=#868e96;fontSize=10;" edge="1" parent="1" source="n_jwtfilter" target="n_stubctl">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ================= EDGES: AUTH ISSUANCE PATH ================= -->
        <mxCell id="e_authctl_authsvc" value="calls" style="endArrow=block;html=1;strokeColor=#2b8a3e;fontSize=10;" edge="1" parent="1" source="n_authctl" target="n_authsvc">
          <mxGeometry relative="1" as="geometry" />
