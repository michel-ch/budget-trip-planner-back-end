        <mxCell id="e_authsvc_jwtutil" value="generateToken" style="endArrow=block;html=1;strokeColor=#c92a2a;fontSize=10;dashed=1;" edge="1" parent="1" source="n_authsvc" target="n_jwtutil">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_authsvc_userdetails" value="encode / authenticate (BCrypt)" style="endArrow=block;html=1;strokeColor=#c92a2a;fontSize=10;dashed=1;" edge="1" parent="1" source="n_authsvc" target="n_userdetails">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_jwtutil_client" value="issues JWT in LoginResponseDTO [TRUST BOUNDARY]" style="endArrow=block;html=1;strokeColor=#c92a2a;strokeWidth=2;dashed=1;fontSize=10;" edge="1" parent="1" source="n_jwtutil" target="n_client">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ================= EDGES: CONTROLLER -> SERVICE -> REPOSITORY ================= -->
        <mxCell id="e_voyagectl_svc" value="calls" style="endArrow=block;html=1;strokeColor=#2b8a3e;fontSize=10;" edge="1" parent="1" source="n_voyagectl" target="n_voyagesvc">
