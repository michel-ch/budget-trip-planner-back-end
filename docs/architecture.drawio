        <mxCell id="e_voyagesvc_repo" value="reads/writes" style="endArrow=block;html=1;strokeColor=#2b8a3e;fontSize=10;" edge="1" parent="1" source="n_voyagesvc" target="n_voyagerepo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_userdetails_userrepo" value="findByUsernameOrEmail" style="endArrow=block;html=1;strokeColor=#c92a2a;fontSize=10;" edge="1" parent="1" source="n_userdetails" target="n_userrepo">
