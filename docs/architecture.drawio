        <mxCell id="e_stubctl_svc" value="calls" style="endArrow=block;html=1;strokeColor=#868e96;fontSize=10;" edge="1" parent="1" source="n_stubctl" target="n_stubsvc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_authsvc_userrepo" value="reads/writes" style="endArrow=block;html=1;strokeColor=#2b8a3e;fontSize=10;" edge="1" parent="1" source="n_authsvc" target="n_userrepo">
          <mxGeometry relative="1" as="geometry" />
