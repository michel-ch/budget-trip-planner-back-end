        <!-- ===================== EDGES (F1-F6) ===================== -->
        <!-- F1 client -> app : HTTP REST :8080 (solid) -->
        <mxCell id="e_f1" parent="1" edge="1" source="client" target="app"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#000000;strokeWidth=1.5;exitX=1;exitY=0.3;entryX=0;entryY=0.25;fontSize=10;fontColor=#000000;labelBackgroundColor=#ffffff;"
          value="F1 HTTP REST :8080">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="440" y="201"/><mxPoint x="440" y="230"/></Array>
          </mxGeometry>
        </mxCell>

        <!-- F2 client -> app : Bearer JWT (solid) -->
        <mxCell id="e_f2" parent="1" edge="1" source="client" target="app"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#000000;strokeWidth=1.5;exitX=1;exitY=0.7;entryX=0;entryY=0.75;fontSize=10;fontColor=#000000;labelBackgroundColor=#ffffff;"
          value="F2 Bearer JWT">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="470" y="229"/><mxPoint x="470" y="290"/></Array>
          </mxGeometry>
        </mxCell>

        <!-- F3 app -> db : JDBC :5432 (solid) -->
        <mxCell id="e_f3" parent="1" edge="1" source="app" target="db"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#000000;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=10;fontColor=#000000;labelBackgroundColor=#ffffff;"
          value="F3 JDBC :5432">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="1050" y="260"/><mxPoint x="1050" y="250"/></Array>
          </mxGeometry>
        </mxCell>

        <!-- F4 dev -> app : JDWP dev only (dotted) -->
        <mxCell id="e_f4" parent="1" edge="1" source="dev" target="app"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=block;strokeColor=#000000;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.85;fontSize=10;fontColor=#000000;labelBackgroundColor=#ffffff;"
          value="F4 JDWP :5005 (dev only)">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="580" y="500"/><mxPoint x="580" y="302"/></Array>
          </mxGeometry>
        </mxCell>

        <!-- F5 cfg -> app : secrets/config (dotted) -->
        <mxCell id="e_f5" parent="1" edge="1" source="cfg" target="app"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=block;strokeColor=#000000;strokeWidth=1.5;exitX=0;exitY=0.5;entryX=0;entryY=0.5;fontSize=10;fontColor=#000000;labelBackgroundColor=#ffffff;"
          value="F5 secrets/config">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="560" y="470"/><mxPoint x="560" y="260"/></Array>
          </mxGeometry>
        </mxCell>

        <!-- F6 build -> app : build & run (dotted) -->
        <mxCell id="e_f6" parent="1" edge="1" source="build" target="app"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=block;strokeColor=#000000;strokeWidth=1.5;exitX=0;exitY=0.5;entryX=0;entryY=0.65;fontSize=10;fontColor=#000000;labelBackgroundColor=#ffffff;"
          value="F6 build &amp; run">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="540" y="570"/><mxPoint x="540" y="278"/></Array>
          </mxGeometry>
        </mxCell>

        <!-- ===================== LEGEND ===================== -->
        <mxCell id="legend" parent="1" vertex="1"
          style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontStyle=1;fontSize=12;fontColor=#000000;fillColor=#FBFBFB;strokeColor=#999999;spacingTop=4;"
          value="Legend">
          <mxGeometry x="60" y="640" width="430" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="legend-cli" parent="1" vertex="1"
          style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#000000;"
          value="Client / External">
          <mxGeometry x="80" y="672" width="150" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="legend-app" parent="1" vertex="1"
          style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#000000;"
          value="Application (Docker)">
          <mxGeometry x="80" y="704" width="150" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="legend-data" parent="1" vertex="1"
          style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#000000;"
          value="Data tier">
          <mxGeometry x="80" y="736" width="150" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="legend-solid" parent="1" vertex="1"
          style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#000000;"
          value=" -  -   solid = runtime / primary (F1, F2, F3)">
          <mxGeometry x="250" y="672" width="230" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="legend-solid-line" parent="1" edge="1"
          style="endArrow=block;html=1;rounded=1;strokeColor=#000000;strokeWidth=1.5;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="252" y="685" as="sourcePoint"/>
            <mxPoint x="282" y="685" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="legend-dotted" parent="1" vertex="1"
          style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#000000;"
          value="- - -  dotted = secondary (F4 ops, F5 secrets, F6 ci/cd)">
          <mxGeometry x="250" y="710" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="legend-dotted-line" parent="1" edge="1"
          style="endArrow=block;html=1;rounded=1;dashed=1;strokeColor=#000000;strokeWidth=1.5;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="252" y="723" as="sourcePoint"/>
            <mxPoint x="282" y="723" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="legend-note" parent="1" vertex="1"
          style="text;html=1;align=left;verticalAlign=top;fontSize=9;fontColor=#555555;"
          value="On-prem / Docker  -  no cloud provider, no external CI/CD. Generic shapes only.&#10;Sub-zone (dashed grey) groups by function inside a perimeter.">
          <mxGeometry x="80" y="788" width="400" height="60" as="geometry"/>
        </mxCell>

        <!-- ===================== GLOSSARY ===================== -->
        <mxCell id="glossary" parent="1" vertex="1"
          style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontStyle=1;fontSize=12;fontColor=#000000;fillColor=#FBFBFB;strokeColor=#999999;spacingTop=4;"
          value="Glossary">
          <mxGeometry x="520" y="700" width="430" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="glossary-body" parent="1" vertex="1"
          style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#000000;spacingTop=2;"
          value="REST  -  Representational State Transfer; HTTP request/response API (F1)&#10;JSON  -  JavaScript Object Notation; request/response body format (F1)&#10;JWT  -  JSON Web Token; signed bearer token proving caller identity (F2)&#10;JDBC  -  Java Database Connectivity; Java-to-SQL driver protocol (F3)&#10;JDWP  -  Java Debug Wire Protocol; remote-debug socket on :5005 (F4)&#10;SPA  -  Single Page Application; the Angular browser client (F1)&#10;CORS  -  Cross-Origin Resource Sharing; only http://localhost:4200 allowed&#10;CI/CD  -  Continuous Integration / Delivery; NOT present in this repo (F6)">
          <mxGeometry x="528" y="728" width="414" height="184" as="geometry"/>
        </mxCell>

        <!-- ===================== DESCRIPTION PANEL (F1-F6) ===================== -->
        <mxCell id="desc" parent="1" vertex="1"
          style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontStyle=1;fontSize=12;fontColor=#000000;fillColor=#FBFBFB;strokeColor=#999999;spacingTop=4;"
          value="Fluxes (F1-F6)">
          <mxGeometry x="990" y="430" width="450" height="490" as="geometry"/>
        </mxCell>
        <mxCell id="desc-body" parent="1" vertex="1"
          style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#000000;spacingTop=2;"
          value="F1  HTTP REST runtime [solid]  -  Browser SPA calls Spring Boot app on :8080 under /api/**; plain HTTP REST/JSON (no TLS in repo). All routes require auth except /api/auth/** and CORS OPTIONS.&#10;&#10;F2  JWT auth, stateless [solid]  -  Each request's Authorization: Bearer &lt;JWT&gt; passes JwtAuthenticationFilter; JwtUtil verifies HMAC256 + issuer planner-app. SessionCreationPolicy.STATELESS; rides on the F1 edge.&#10;&#10;F3  JDBC persistence [solid]  -  App (HikariCP pool) reads/writes PostgreSQL at :5432/tripbudgetplanner via the PostgreSQL JDBC driver; DB creds from SPRING_DATASOURCE_* (see F5).&#10;&#10;F4  JDWP remote debug, DEV ONLY [dotted]  -  Dockerfile exposes :5005 and runs the JVM with -agentlib:jdwp (dt_socket); a developer IDE attaches. Must not be exposed in production.&#10;&#10;F5  Secrets / config injection [dotted]  -  Container env vars (SPRING_DATASOURCE_URL/USERNAME/PASSWORD) and property keys (jwt.secret, jwt.expiration) resolve into the Spring context at startup. Names/keys only  -  never values.&#10;&#10;F6  Image build &amp; run [dotted]  -  Dockerfile primes the Maven cache (mvn dependency:go-offline) then CMD runs mvn spring-boot:run (dev profile). No external CI/CD pipeline detected.">
          <mxGeometry x="998" y="458" width="434" height="454" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
