<mxfile host="app.diagrams.net" type="device">
  <diagram name="context" id="context-L0">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===================== TITLE ===================== -->
        <mxCell id="title" parent="1" vertex="1"
          style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=18;fontColor=#000000;"
          value="Budget Trip Planner  -  Context (L0): system as one box + external actors (F1-F6)">
          <mxGeometry x="40" y="20" width="980" height="30" as="geometry"/>
        </mxCell>

        <!-- ===================== MEGA BOXES ===================== -->
        <!-- Client / External (blue bg) : LEFT -->
        <mxCell id="mega-client" parent="1" vertex="1"
          style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontStyle=1;fontSize=14;fontColor=#2A4B7C;fillColor=#EAF2FD;strokeColor=#6C8EBF;strokeWidth=2;spacingTop=4;"
          value="Client / External">
          <mxGeometry x="60" y="120" width="300" height="460" as="geometry"/>
        </mxCell>

        <!-- Application container (Docker) (orange bg) : CENTER -->
        <mxCell id="mega-app" parent="1" vertex="1"
          style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontStyle=1;fontSize=14;fontColor=#9A5B00;fillColor=#FFF7E6;strokeColor=#D79B00;strokeWidth=2;spacingTop=4;"
          value="Application container (Docker)">
          <mxGeometry x="520" y="120" width="460" height="540" as="geometry"/>
        </mxCell>

        <!-- Build & Config sub-zone inside app mega -->
        <mxCell id="zone-bc" parent="1" vertex="1"
          style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontStyle=1;fontSize=11;fontColor=#000000;fillColor=none;strokeColor=#bbbbbb;dashed=1;spacingTop=2;"
          value="Build &amp; Config">
          <mxGeometry x="560" y="400" width="380" height="220" as="geometry"/>
        </mxCell>

        <!-- Data tier (green bg) : RIGHT -->
        <mxCell id="mega-data" parent="1" vertex="1"
          style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontStyle=1;fontSize=14;fontColor=#2D6A2D;fillColor=#E9F5E8;strokeColor=#82B366;strokeWidth=2;spacingTop=4;"
          value="Data tier">
          <mxGeometry x="1140" y="120" width="300" height="280" as="geometry"/>
        </mxCell>

        <!-- ===================== COMPONENT NODES ===================== -->
        <!-- client -->
        <mxCell id="client" parent="1" vertex="1"
          style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;spacingLeft=20;arcSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#000000;"
          value="Browser SPA&#10;(Angular dev, http://localhost:4200)">
          <mxGeometry x="100" y="180" width="220" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="logo-client" parent="1" vertex="1"
          style="sketch=0;outlineConnect=0;html=1;aspect=fixed;shape=mxgraph.aws4.user;fillColor=#6C8EBF;strokeColor=#ffffff;"
