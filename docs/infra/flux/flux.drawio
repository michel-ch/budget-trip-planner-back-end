        <!-- ===================== GLOSSARY ===================== -->
        <mxCell id="glossary" parent="1" vertex="1"
          style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontStyle=1;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#999999;spacingTop=4;"
          value="Glossary">
          <mxGeometry x="40" y="620" width="500" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="glossary-body" parent="1" vertex="1"
          style="text;html=1;align=left;verticalAlign=top;fontSize=9;fontColor=#000000;"
          value="JDWP — Java Debug Wire Protocol. Remote-debug socket on port 5005 (F4).&#10;CI/CD — Continuous Integration / Delivery. Automated build/deploy — NOT present in this repo (F6).&#10;SPRING_DATASOURCE_URL / _USERNAME / _PASSWORD — container env vars carrying DB connection + credentials (F5).&#10;jwt.secret / jwt.expiration — application property keys read by JwtUtil (F5; names/keys only, never values).&#10;dt_socket — JDWP socket transport over TCP used by the JVM debug agent (F4).">
          <mxGeometry x="50" y="646" width="485" height="128" as="geometry"/>
        </mxCell>

        <!-- ===================== DESCRIPTION PANEL ===================== -->
        <mxCell id="desc" parent="1" vertex="1"
          style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontStyle=1;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#999999;spacingTop=4;"
          value="Flux descriptions (this view)">
          <mxGeometry x="560" y="670" width="640" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="desc-body" parent="1" vertex="1"
          style="text;html=1;align=left;verticalAlign=top;fontSize=9;fontColor=#000000;"
          value="F4 — JDWP remote debug (DEV ONLY): Developer IDE attaches to the JVM debug agent on :5005 over dt_socket (TCP). No auth (open dev socket); debug control only, no business data. Must not be exposed in production.&#10;&#10;F5 — Secrets / config injection: container env vars (SPRING_DATASOURCE_URL / _USERNAME / _PASSWORD) and property keys (jwt.secret, jwt.expiration) resolved into the Spring context once at startup. Names/keys only — never values.&#10;&#10;F6 — Image build &amp; run: the Dockerfile primes the Maven cache (mvn dependency:go-offline) then the container CMD runs mvn spring-boot:run (dev profile). NO external CI/CD pipeline (Dockerfile only).&#10;&#10;Note: Spring Boot DevTools / LiveReload and the prod profile are scaffolded / not-wired; not drawn as fluxes.">
          <mxGeometry x="570" y="696" width="620" height="168" as="geometry"/>
        </mxCell>

