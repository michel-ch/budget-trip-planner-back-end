        <!-- ===================== EDGES ===================== -->
        <!-- F1 : client -> app  (HTTP REST /api/**) routes down the corridor below the Edge/Auth zone -->
        <mxCell id="e-f1" parent="1" edge="1" source="client" target="app"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#000000;strokeWidth=1.5;exitX=1;exitY=0.75;entryX=0;entryY=0.5;fontSize=9;fontColor=#000000;labelBackgroundColor=#ffffff;"
