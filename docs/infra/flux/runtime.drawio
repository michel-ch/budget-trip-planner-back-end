<mxfile host="app.diagrams.net">
  <diagram name="runtime" id="runtime-L1">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===================== TITLE ===================== -->
        <mxCell id="title" parent="1" vertex="1"
          style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=16;fontColor=#000000;"
          value="Runtime (L1) - request / data path : F1 + F2 + F3">
          <mxGeometry x="40" y="20" width="700" height="30" as="geometry"/>
        </mxCell>

        <!-- ===================== MEGA BOXES ===================== -->
        <!-- Client / External (perimeter B palette) -->
        <mxCell id="mega-client" parent="1" vertex="1"
          style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontStyle=1;fontSize=14;fontColor=#3A5A8C;fillColor=#EAF2FD;strokeColor=#6C8EBF;strokeWidth=2;spacingTop=4;"
          value="Client / External">
          <mxGeometry x="40" y="120" width="260" height="320" as="geometry"/>
        </mxCell>

        <!-- Application container (Docker) (perimeter A palette) -->
        <mxCell id="mega-app" parent="1" vertex="1"
          style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontStyle=1;fontSize=14;fontColor=#9A5B00;fillColor=#FFF7E6;strokeColor=#D79B00;strokeWidth=2;spacingTop=4;"
          value="Application container (Docker)">
          <mxGeometry x="470" y="120" width="520" height="500" as="geometry"/>
        </mxCell>

        <!-- Data tier (perimeter C palette) -->
        <mxCell id="mega-data" parent="1" vertex="1"
          style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontStyle=1;fontSize=14;fontColor=#3F6B33;fillColor=#EAF7E6;strokeColor=#82B366;strokeWidth=2;spacingTop=4;"
          value="Data tier">
          <mxGeometry x="1160" y="120" width="200" height="320" as="geometry"/>
        </mxCell>

        <!-- ===================== SUB-ZONE: Edge / Auth ===================== -->
        <mxCell id="zone-edge" parent="1" vertex="1"
          style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontStyle=1;fontSize=11;fontColor=#000000;fillColor=none;strokeColor=#bbbbbb;dashed=1;spacingTop=2;"
          value="Edge / Auth">
          <mxGeometry x="500" y="170" width="460" height="160" as="geometry"/>
        </mxCell>

        <!-- ===================== COMPONENT NODES ===================== -->
        <!-- client -->
        <mxCell id="client" parent="1" vertex="1"
          style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacingLeft=20;arcSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#000000;"
          value="Browser SPA&#10;Angular, :4200">
          <mxGeometry x="80" y="250" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="logo-client" parent="1" vertex="1"
          style="sketch=0;outlineConnect=0;html=1;aspect=fixed;shape=mxgraph.aws4.user;fillColor=#5A6C86;strokeColor=#ffffff;"
          value="">
          <mxGeometry x="86" y="256" width="20" height="20" as="geometry"/>
        </mxCell>

        <!-- sec (entry gate, inside Edge/Auth sub-zone) -->
        <mxCell id="sec" parent="1" vertex="1"
          style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacingLeft=20;arcSize=10;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#000000;"
          value="Spring Security filter chain&#10;JwtAuthenticationFilter + JwtUtil&#10;HMAC256, issuer planner-app, STATELESS">
          <mxGeometry x="540" y="210" width="380" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="logo-sec" parent="1" vertex="1"
          style="sketch=0;outlineConnect=0;html=1;aspect=fixed;shape=mxgraph.aws4.traditional_server;fillColor=#D79B00;strokeColor=#ffffff;"
          value="">
          <mxGeometry x="546" y="216" width="20" height="20" as="geometry"/>
        </mxCell>

        <!-- app (service, after the gate) -->
        <mxCell id="app" parent="1" vertex="1"
          style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacingLeft=20;arcSize=10;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#000000;"
          value="Spring Boot app&#10;Java 21, SB 3.5.6, :8080">
          <mxGeometry x="600" y="470" width="260" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="logo-app" parent="1" vertex="1"
          style="sketch=0;outlineConnect=0;html=1;aspect=fixed;shape=mxgraph.aws4.traditional_server;fillColor=#D79B00;strokeColor=#ffffff;"
          value="">
          <mxGeometry x="606" y="476" width="20" height="20" as="geometry"/>
        </mxCell>

        <!-- db -->
        <mxCell id="db" parent="1" vertex="1"
          style="shape=cylinder;whiteSpace=wrap;html=1;fontSize=10;spacingLeft=20;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#000000;"
          value="PostgreSQL&#10;tripbudgetplanner&#10;:5432">
          <mxGeometry x="1200" y="240" width="130" height="90" as="geometry"/>
        </mxCell>

        <!-- ===================== OFF-PAGE CONNECTOR PORTS (reference notes) ===================== -->
        <mxCell id="port-cfg" parent="1" vertex="1"
          style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fontSize=9;fontColor=#666666;fillColor=#FBFBFB;strokeColor=#999999;align=left;"
          value="config injected at startup&#10;-&gt; see Ops view (F5)">
          <mxGeometry x="500" y="560" width="180" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="port-img" parent="1" vertex="1"
          style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fontSize=9;fontColor=#666666;fillColor=#FBFBFB;strokeColor=#999999;align=left;"
          value="image built &amp; run&#10;-&gt; see Ops view (F6)">
          <mxGeometry x="780" y="560" width="170" height="46" as="geometry"/>
        </mxCell>

        <!-- ===================== EDGES ===================== -->
        <!-- F1 : client -> app  (HTTP REST /api/**) routes down the corridor below the Edge/Auth zone -->
        <mxCell id="e-f1" parent="1" edge="1" source="client" target="app"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#000000;strokeWidth=1.5;exitX=1;exitY=0.75;entryX=0;entryY=0.5;fontSize=9;fontColor=#000000;labelBackgroundColor=#ffffff;"
          value="F1 HTTP /api/**">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="400" y="295"/>
              <mxPoint x="400" y="505"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- F2 : client -> sec (Authorization: Bearer JWT) into the entry gate -->
        <mxCell id="e-f2" parent="1" edge="1" source="client" target="sec"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#000000;strokeWidth=1.5;exitX=1;exitY=0.25;entryX=0;entryY=0.5;fontSize=9;fontColor=#000000;labelBackgroundColor=#ffffff;"
          value="F2 Bearer JWT">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="430" y="265"/>
              <mxPoint x="430" y="250"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- sec -> app : validated before the service handles the request -->
        <mxCell id="e-gate" parent="1" edge="1" source="sec" target="app"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#000000;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=9;fontColor=#000000;labelBackgroundColor=#ffffff;dashPattern=1 1;"
          value="validated before service">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="730" y="400"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- F3 : app -> db (JDBC :5432) right across to the data tier -->
        <mxCell id="e-f3" parent="1" edge="1" source="app" target="db"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#000000;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=9;fontColor=#000000;labelBackgroundColor=#ffffff;"
          value="F3 JDBC :5432">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1075" y="505"/>
              <mxPoint x="1075" y="285"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ===================== ANNOTATION: public routes on F1 ===================== -->
        <mxCell id="note-public" parent="1" vertex="1"
          style="text;html=1;align=left;verticalAlign=top;fontSize=9;fontColor=#555555;"
          value="F1 note: /api/auth/** + OPTIONS are permitAll (public)">
          <mxGeometry x="330" y="650" width="320" height="20" as="geometry"/>
        </mxCell>

        <!-- ===================== LEGEND ===================== -->
        <mxCell id="legend-box" parent="1" vertex="1"
          style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontStyle=1;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#999999;spacingTop=4;"
          value="Legend">
          <mxGeometry x="40" y="690" width="300" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="legend-c1" parent="1" vertex="1"
          style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#000000;"
          value="Client / External">
          <mxGeometry x="52" y="716" width="120" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="legend-c2" parent="1" vertex="1"
          style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#000000;"
          value="Application (Docker)">
          <mxGeometry x="52" y="744" width="120" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="legend-c3" parent="1" vertex="1"
          style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#000000;"
          value="Data tier">
          <mxGeometry x="52" y="772" width="120" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="legend-line" parent="1" edge="1" source="" target=""
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#000000;strokeWidth=1.5;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="190" y="810" as="sourcePoint"/>
            <mxPoint x="250" y="810" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="legend-line-lbl" parent="1" vertex="1"
          style="text;html=1;align=left;verticalAlign=middle;fontSize=9;fontColor=#000000;"
          value="solid = runtime / primary flux (F1, F2, F3)">
          <mxGeometry x="52" y="822" width="280" height="20" as="geometry"/>
        </mxCell>

        <!-- ===================== GLOSSARY ===================== -->
        <mxCell id="glossary" parent="1" vertex="1"
          style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=9;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#999999;spacingTop=6;spacingRight=8;"
          value="Glossary&#10;REST - Representational State Transfer (HTTP request/response API, F1)&#10;JSON - JavaScript Object Notation (F1 body format)&#10;JWT - JSON Web Token (signed bearer token proving identity, F2)&#10;HS256 / HMAC256 - HMAC with SHA-256 (symmetric JWT signing, F2)&#10;JDBC - Java Database Connectivity (Java to SQL driver, F3)&#10;HikariCP - Hikari Connection Pool (default JDBC pool, F3)&#10;JPA - Jakarta Persistence API (ORM over JDBC via Hibernate, F3)&#10;SPA - Single Page Application (the Angular browser client, F1)&#10;CORS - Cross-Origin Resource Sharing (only http://localhost:4200 allowed)">
          <mxGeometry x="370" y="690" width="520" height="160" as="geometry"/>
        </mxCell>

        <!-- ===================== DESCRIPTION PANEL ===================== -->
        <mxCell id="desc" parent="1" vertex="1"
          style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=9;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#999999;spacingTop=6;spacingRight=8;"
          value="Fluxes (this view)&#10;F1 HTTP REST runtime - Browser SPA calls the Spring Boot app on :8080 under /api/** over plain HTTP REST/JSON; all routes require auth except /api/auth/** and OPTIONS (permitAll).&#10;F2 JWT auth (stateless) - Each request's Authorization: Bearer JWT passes JwtAuthenticationFilter; JwtUtil verifies the HMAC256 signature and issuer planner-app, populates the SecurityContext. No server session (STATELESS). Auth check rides on the F1 request, gating before the app service.&#10;F3 JDBC persistence - The app persists via Spring Data JPA / Hibernate over the PostgreSQL JDBC driver to :5432/tripbudgetplanner; connections pooled by HikariCP; credentials supplied via SPRING_DATASOURCE_* env vars.">
          <mxGeometry x="1010" y="560" width="380" height="290" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
