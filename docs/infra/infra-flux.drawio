        <mxCell id="logo-jdwp" parent="1" vertex="1" style="sketch=0;outlineConnect=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;fillColor=#7AA116;strokeColor=#ffffff;resIcon=mxgraph.aws4.bug;" value="">
