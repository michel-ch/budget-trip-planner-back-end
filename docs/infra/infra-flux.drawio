        <mxCell id="logo-app" parent="1" vertex="1" style="sketch=0;outlineConnect=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;fillColor=#ED7100;strokeColor=#ffffff;resIcon=mxgraph.aws4.traditional_server;" value="">
