        <mxCell id="n-build" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacingLeft=20;arcSize=10;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#000000;" value="Docker image build&#10;mvn dependency:go-offline → mvn spring-boot:run (dev profile)">
          <mxGeometry x="560" y="510" width="430" height="50" as="geometry" />
        </mxCell>
        <mxCell id="logo-build" parent="1" vertex="1" style="sketch=0;outlineConnect=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;fillColor=#693CC5;strokeColor=#ffffff;resIcon=mxgraph.aws4.gears;" value="">
          <mxGeometry x="564" y="514" width="20" height="20" as="geometry" />
        </mxCell>

        <!-- Data tier perimeter -->
        <mxCell id="n-pg" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacingLeft=20;arcSize=10;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#000000;" value="PostgreSQL&#10;tripbudgetplanner&#10;:5432">
          <mxGeometry x="1240" y="150" width="150" height="64" as="geometry" />
        </mxCell>
        <mxCell id="logo-pg" parent="1" vertex="1" style="sketch=0;outlineConnect=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;fillColor=#3334B9;strokeColor=#ffffff;resIcon=mxgraph.aws4.database;" value="">
          <mxGeometry x="1244" y="154" width="20" height="20" as="geometry" />
        </mxCell>

        <!-- ===================== EDGES (fluxes) ===================== -->
        <!-- F1: SPA -> app (right side of SPA -> left/top of app). Through corridor x~400. -->
        <mxCell id="e-f1" parent="1" edge="1" source="n-spa" target="n-app" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#000000;strokeWidth=1.5;exitX=1;exitY=0.3;entryX=0;entryY=0.3;fontSize=9;fontColor=#000000;labelBackgroundColor=#ffffff;" value="F1 HTTP REST/JSON :8080">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="400" y="168" />
              <mxPoint x="400" y="169" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- F2: SPA -> security chain (Bearer JWT). Corridor x~420, down to y~278. -->
        <mxCell id="e-f2" parent="1" edge="1" source="n-spa" target="n-sec" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#000000;strokeWidth=1.5;dashed=1;exitX=1;exitY=0.7;entryX=0;entryY=0.5;fontSize=9;fontColor=#000000;labelBackgroundColor=#ffffff;" value="F2 Bearer JWT (stateless)">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="420" y="192" />
              <mxPoint x="420" y="278" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- F3: app -> postgres (right of app -> left of pg). Through corridor x~1110. -->
        <mxCell id="e-f3" parent="1" edge="1" source="n-app" target="n-pg" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#000000;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=9;fontColor=#000000;labelBackgroundColor=#ffffff;" value="F3 JDBC :5432 (HikariCP)">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1110" y="182" />
              <mxPoint x="1110" y="182" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- F4: IDE -> jdwp agent (dev only). Bottom lane y~620, right-of-nodes lane x~1015, up to jdwp right side. -->
        <mxCell id="e-f4" parent="1" edge="1" source="n-ide" target="n-jdwp" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#000000;strokeWidth=1.5;dashed=1;exitX=1;exitY=0.5;entryX=1;entryY=0.5;fontSize=9;fontColor=#000000;labelBackgroundColor=#ffffff;" value="F4 JDWP :5005 (dev only)">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="460" y="495" />
              <mxPoint x="460" y="620" />
              <mxPoint x="1015" y="620" />
              <mxPoint x="1015" y="278" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- F5: env -> app (config injection). Up the left lane x~540 (clear of nodes that start at x560). -->
        <mxCell id="e-f5" parent="1" edge="1" source="n-env" target="n-app" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#000000;strokeWidth=1.5;exitX=0;exitY=0.5;entryX=0;entryY=0.7;fontSize=9;fontColor=#000000;labelBackgroundColor=#ffffff;" value="F5 config injection">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="540" y="415" />
              <mxPoint x="540" y="195" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- F6: build -> app (build & run). Right corridor x~1010, up to app right-low. -->
        <mxCell id="e-f6" parent="1" edge="1" source="n-build" target="n-app" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#000000;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=1;entryY=0.7;fontSize=9;fontColor=#000000;labelBackgroundColor=#ffffff;" value="F6 build &amp; run">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1010" y="535" />
              <mxPoint x="1010" y="195" />
              <mxPoint x="760" y="195" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ===================== LEGEND ===================== -->
        <mxCell id="legend" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontStyle=1;fontSize=11;fontColor=#000000;fillColor=#FBFBFB;strokeColor=#999999;spacingLeft=8;spacingTop=6;" value="Legend">
          <mxGeometry x="40" y="640" width="300" height="200" as="geometry" />
        </mxCell>
        <mxCell id="legend-txt" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#000000;" value="Perimeter colors:&#10;&#10;■ Blue  = Client / External&#10;■ Orange = Application container (Docker)&#10;■ Green = Data tier (PostgreSQL)&#10;&#10;Arrows: orthogonal, black — one per flux (F#).&#10;Dashed arrow = dev-only / auth-on-request.&#10;Dashed node = development-only component.">
          <mxGeometry x="52" y="668" width="280" height="165" as="geometry" />
        </mxCell>

        <!-- ===================== GLOSSARY ===================== -->
        <mxCell id="glossary" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontStyle=1;fontSize=11;fontColor=#000000;fillColor=#FBFBFB;strokeColor=#999999;spacingLeft=8;spacingTop=6;" value="Glossary">
          <mxGeometry x="370" y="640" width="380" height="200" as="geometry" />
        </mxCell>
        <mxCell id="glossary-txt" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#000000;" value="REST/JSON — HTTP request/response API + body format (F1)&#10;JWT / HS256 — signed bearer token, HMAC-SHA256 (F2)&#10;JDBC — Java↔SQL driver protocol to PostgreSQL (F3)&#10;HikariCP — Spring Boot default JDBC connection pool (F3)&#10;DDL — CREATE TABLE schema in V1__Init_Setup.sql (F3)&#10;JPA — Jakarta Persistence (Hibernate) over JDBC (F3)&#10;JDWP — Java Debug Wire Protocol, port 5005 (F4)&#10;SPA / CORS — browser client; only :4200 allowed&#10;CI/CD — build/deploy automation — NOT present (F6)&#10;OIDC — not used (self-issued JWT via java-jwt)">
          <mxGeometry x="382" y="668" width="360" height="165" as="geometry" />
        </mxCell>

        <!-- ===================== DESCRIPTION PANEL (F1..F6) ===================== -->
        <mxCell id="panel" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontStyle=1;fontSize=11;fontColor=#000000;fillColor=#FBFBFB;strokeColor=#999999;spacingLeft=8;spacingTop=6;" value="Fluxes (identical to docs/infra/infra-flux.md)">
          <mxGeometry x="780" y="640" width="630" height="280" as="geometry" />
        </mxCell>
        <mxCell id="panel-txt" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#000000;" value="F1  HTTP REST runtime — Browser SPA → Spring Boot app :8080 /api/**. HTTP REST/JSON.&#10;        Auth required except /api/auth/** and OPTIONS. (server.port=8080; Dockerfile EXPOSE 8080)&#10;&#10;F2  JWT auth (stateless) — Authorization: Bearer &lt;JWT&gt; → JwtAuthenticationFilter → JwtUtil&#10;        (HMAC256, issuer planner-app). SessionCreationPolicy.STATELESS. Rides the F1 request.&#10;&#10;F3  JDBC persistence — app (HikariCP) → PostgreSQL :5432/tripbudgetplanner via org.postgresql.Driver.&#10;        Credentials from SPRING_DATASOURCE_* env vars (see F5). Schema in V1__Init_Setup.sql.&#10;&#10;F4  JDWP remote debug (DEV ONLY) — Developer IDE → JVM agent :5005 (dt_socket).&#10;        Dockerfile EXPOSE 5005 + -agentlib:jdwp …address=*:5005. Must not be exposed in prod.&#10;&#10;F5  Secrets / config injection — container env vars (SPRING_DATASOURCE_URL/USERNAME/PASSWORD) +&#10;        property keys (jwt.secret, jwt.expiration) → Spring context. Names/keys only, never values.&#10;&#10;F6  Image build &amp; run — Dockerfile: mvn dependency:go-offline → mvn spring-boot:run (dev profile).&#10;        No external CI/CD pipeline file detected. No external object storage (Images = url TEXT only).">
          <mxGeometry x="792" y="668" width="610" height="245" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
