<mxfile host="app.diagrams.net">
  <diagram name="infra-flux" id="infra-flux-budget-trip-planner">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===================== TITLE ===================== -->
        <mxCell id="title" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=18;fontColor=#000000;" value="Budget Trip Planner — Infrastructure Flux Diagram (on-prem / Docker)">
          <mxGeometry x="40" y="20" width="900" height="30" as="geometry" />
        </mxCell>

        <!-- ===================== MEGA BOXES (perimeters) ===================== -->
