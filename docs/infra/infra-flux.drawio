        </mxCell>

        <mxCell id="mega-data" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontStyle=1;fontSize=14;fontColor=#3A6B33;fillColor=#EAF8E6;strokeColor=#82B366;strokeWidth=2;spacingTop=6;" value="Data tier (PostgreSQL)">
