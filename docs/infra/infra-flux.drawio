        <mxCell id="logo-sec" parent="1" vertex="1" style="sketch=0;outlineConnect=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;fillColor=#C7131F;strokeColor=#ffffff;resIcon=mxgraph.aws4.shield;" value="">
