          <mxGeometry x="520" y="480" width="500" height="90" as="geometry" />
        </mxCell>

        <!-- ===================== NODES ===================== -->
        <!-- Client perimeter -->
        <mxCell id="n-spa" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacingLeft=20;arcSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#000000;" value="Browser SPA&#10;Angular dev&#10;http://localhost:4200">
          <mxGeometry x="80" y="150" width="180" height="60" as="geometry" />
